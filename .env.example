# ── Progress Agentic RAG connection (required unless ARAG_MOCK=1) ──────────────
ARAG_KB_ID=                       # Knowledge Box id (uuid)
ARAG_API_KEY=                     # KB service-account token (X-NUCLIA-SERVICEACCOUNT). Never commit.
ARAG_REGION=aws-us-east-2-1       # zone slug; or set ARAG_BASE_URL to override the host entirely
#ARAG_BASE_URL=https://aws-us-east-2-1.dp.progress.cloud/api/v1
ARAG_GENERATIVE_MODEL=chatgpt-azure-4o   # multimodal model used for visual extraction; empty = KB default
ARAG_RERANKER=predict             # predict (cross-encoder, grounded) | noop (fast)
ARAG_TIMEOUT_MS=60000             # per-request timeout to ARAG; visual extraction can be slow
ARAG_MOCK=0                       # 1 = use the in-process mock ARAG (no credentials needed)

# ── Document Processing specifics ─────────────────────────────────────────────
DIP_EXTRACT_STRATEGY=             # ARAG extract-strategy id applied to image/PDF uploads
                                  # (ingestion-time visual-LLM extraction). Legacy name
                                  # ARAG_EXTRACT_STRATEGY is still honoured.
DIP_MAX_UPLOAD_BYTES=26214400     # max upload size (25 MB). Legacy name MAX_UPLOAD_BYTES honoured.

# ── Service ───────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info                    # debug | info | warn | error
DATA_DIR=./data                   # JSON stores (documents, jobs, extraction configs)
PUBLIC_URL=http://localhost:8080

# ── Security ──────────────────────────────────────────────────────────────────
ADMIN_TOKEN=                      # required to open /admin and /api/v1/admin/*; generate: openssl rand -hex 24
API_KEYS=                         # comma-separated; when set, /api/v1 requires X-API-Key (the demo UI uses
                                  # a session cookie). Strongly recommended for any internet-facing
                                  # deployment: without it reads and uploads are open (rate-limited).
                                  # DELETEs always need an API key, the admin token, or a session cookie
                                  # from POST /api/v1/session.
ALLOWED_ORIGINS=                  # comma-separated CORS origins; empty = same-origin only
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=20
TRUST_PROXY=fly                   # which proxy header identifies the client IP for rate limiting:
                                  # fly (default: trust Fly-Client-IP) | xff (first X-Forwarded-For) | none
MAX_BODY_BYTES=26214400           # hard HTTP body cap (uploads are additionally capped by DIP_MAX_UPLOAD_BYTES)
