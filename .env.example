# ─── Progress Agentic RAG (ARAG) connection ───────────────────────────────────
# The Knowledge Box ask/upload base URL. For the DocumentProcessing KB this is the
# full /api/v1/kb/<id> URL on the dp.progress.cloud host. The bridge derives every
# other endpoint (upload, resource, ask, find) from this single base.
ARAG_KB_URL=https://aws-us-east-2-1.dp.progress.cloud/api/v1/kb/5f268076-7287-4432-b0f0-436e8a8b224f

# Nuclia service-account JWT (sent as `X-NUCLIA-SERVICEACCOUNT: Bearer <token>`).
# Keep this secret — never commit the real value.
ARAG_TOKEN=

# Generative model the KB uses for extraction/augmentation. The DocumentProcessing
# KB defaults to the multimodal chatgpt-azure-4o, which the demo relies on for
# visual/page extraction. Override only if the KB's available models change.
ARAG_GENERATIVE_MODEL=chatgpt-azure-4o

# Reranker for retrieval: "predict" (cross-encoder, grounded/accurate) or
# "noop" (fast). Extraction defaults to predict for deterministic, grounded output.
ARAG_RERANKER=predict

# Per-request timeout to ARAG (ms). Visual extraction on large pages can be slow.
ARAG_TIMEOUT_MS=60000

# ─── Bridge server ────────────────────────────────────────────────────────────
PORT=8080
# Max upload size in bytes (default 25 MB).
MAX_UPLOAD_BYTES=26214400
# Log level: debug | info | warn | error
LOG_LEVEL=info
